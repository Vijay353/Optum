# EvidenceBridge configuration — copy to .env. NO REAL SECRETS IN THIS FILE.
# Mode: SIMULATED (default, fully local) | SANDBOX | LIVE
EB_MODE=SIMULATED
EB_PORT=8787
# Bind address. Keep 127.0.0.1 locally; the container image sets 0.0.0.0. PORT is accepted if EB_PORT is unset.
EB_HOST=127.0.0.1
# Empty database at startup: seed-if-empty (default) or never. A database with records is never reseeded.
EB_BOOTSTRAP=seed-if-empty

# Visitor access gate (V3 CH-20). Off by default on 127.0.0.1. Required, and cannot be turned off,
# when EB_HOST is any other address. Set real values only as secrets in the deployment panel.
# The PIN is never a VITE_ variable and never reaches the browser bundle.
# EB_ACCESS_GATE=on
# EB_ACCESS_PIN=0000
# EB_SESSION_SECRET=REPLACE_ME_with_openssl_rand_hex_32
# EB_SESSION_TTL_MINUTES=120
# Number of trusted reverse proxies in front of the app (1 behind Coolify). Leave unset otherwise.
# EB_TRUST_PROXY=1

# Coolify naming aliases (accepted as-is; EB_* wins when both are set).
# OPTOM_ACCESS_GATE=true      # true/false also accepted (maps to on/off)
# OPTOM_ACCESS_PIN=0000
# OPTOM_SESSION_SECRET=REPLACE_ME_with_openssl_rand_hex_32
# OPTOM_TRUST_PROXY=true      # true maps to 1
# OPTOM_ALLOW_DEMO_RESET=false
# OPTOM_CLARITY_PROJECT_ID=
# PORT=8080                  # accepted when EB_PORT is unset (Coolify default)
# VITE_CLARITY_PROJECT_ID=   # accepted as a runtime fallback for EB_CLARITY_PROJECT_ID
# VITE_CLARITY_ALLOW_LOCAL=false

# Optional analytics (V3 CH-21): your existing Microsoft Clarity project id (public identifier, not a secret).
# Leave unset for no analytics. Loads only behind the access gate, after the visitor chooses Allow.
# Off on localhost and under browser automation unless EB_ANALYTICS_ALLOW_LOCAL=true (tests only).
# EB_CLARITY_PROJECT_ID=
# Demo reset lock (throwaway demos keep the default true). When false,
# POST /api/scenarios/:id/load returns 403 so the seeded demo cannot be reset.
# EB_ALLOW_DEMO_RESET=true

# SQLite file for all local simulators (schema-separated per simulator)
EB_DB_PATH=data/runtime/evidencebridge.sqlite
# Backups (npm run backup): directory and how many to keep
EB_BACKUP_DIR=data/runtime/backups
EB_BACKUP_KEEP=14
# An evaluated run older than this cannot be staged (hours). It must be checked again.
EB_MAX_RUN_AGE_HOURS=24
# Outbound client timeout for adapter calls (ms)
EB_HTTP_TIMEOUT_MS=1500

# Evidence extractor: fixture (default, deterministic, no network) | llm (optional, disabled)
EB_EXTRACTOR=fixture
# Only read when EB_EXTRACTOR=llm. Server-side only; never exposed to the browser bundle.
ANTHROPIC_API_KEY=sk-ant-REPLACE_ME_DUMMY
EB_LLM_MODEL=claude-sonnet-5-5

# SANDBOX / LIVE adapters (TO_VERIFY — payer- and HIE-specific; see docs/INTEGRATIONS.md)
EB_EHR_FHIR_BASE_URL=https://ehr-sandbox.example.invalid/fhir
EB_EHR_CLIENT_ID=dummy-client-id
EB_EHR_CLIENT_SECRET=dummy-client-secret
EB_PAYER_PROVIDER_ACCESS_BASE_URL=https://payer-sandbox.example.invalid/provider-access
EB_PAYER_CLIENT_ID=dummy-client-id
EB_PAYER_CLIENT_SECRET=dummy-client-secret
EB_HIE_BASE_URL=https://hie-sandbox.example.invalid/fhir
EB_HIE_CLIENT_CERT_PATH=/path/to/dummy-cert.pem
EB_POLICY_ADAPTER=synthetic

# Product P10: presentation mode. "pitch" hides the Demo Lab and Data Studio tab,
# fixes the demo identity to PA specialist and shows a guided tour. Presentation
# only: the server behaves the same. ?mode=demo in the URL restores full chrome.
# EB_UI_MODE=demo
