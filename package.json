{
  "name": "optum-evidencebridge",
  "private": true,
  "version": "0.1.0",
  "description": "Conceptual Optum EvidenceBridge pre-submission evidence review vertical slice (synthetic data only, not an official Optum product)",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,green \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "cross-env NODE_OPTIONS=--disable-warning=ExperimentalWarning tsx watch --clear-screen=false server/index.ts",
    "dev:web": "vite",
    "start": "npm run build && cross-env NODE_ENV=production NODE_OPTIONS=--disable-warning=ExperimentalWarning tsx server/index.ts",
    "seed": "cross-env NODE_OPTIONS=--disable-warning=ExperimentalWarning tsx scripts/seed.ts",
    "template": "cross-env NODE_OPTIONS=--disable-warning=ExperimentalWarning tsx scripts/buildTemplates.ts",
    "demo:cli": "cross-env NODE_OPTIONS=--disable-warning=ExperimentalWarning tsx scripts/demoCli.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "test": "cross-env NODE_OPTIONS=--disable-warning=ExperimentalWarning vitest run",
    "test:watch": "vitest",
    "build": "vite build",
    "check": "npm run typecheck && npm run lint && npm run test && npm run build && npm run check:bundle",
    "test:e2e": "playwright test",
    "check:bundle": "tsx scripts/checkClientBundle.ts",
    "bootstrap": "cross-env NODE_OPTIONS=--disable-warning=ExperimentalWarning tsx scripts/bootstrap.ts",
    "backup": "cross-env NODE_OPTIONS=--disable-warning=ExperimentalWarning tsx scripts/backupDb.ts",
    "start:prod": "node --disable-warning=ExperimentalWarning --import tsx server/index.ts"
  },
  "dependencies": {
    "exceljs": "^4.4.0",
    "express": "^5.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tsx": "^4.23.15",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "cross-env": "^10.1.0",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
}
